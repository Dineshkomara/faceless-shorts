# Optional machine-specific overrides. Copy to .env; never commit .env.
# By default, paths resolve from this cloned repository.
# PIPELINE_ROOT=/absolute/path/to/clone
# PIPELINE_PROJECTS_DIR=/absolute/path/to/clone/projects
# SKILL_DIR=/absolute/path/to/clone/.agents/skills/faceless-shorts
# OPENCODE_CLI=/path/to/opencode
# DASHBOARD_PORT=8788
# DASHBOARD_HOST=127.0.0.1

# Optional read-only YouTube Analytics integration.
# YT_ANALYTICS_CLIENT_JSON=/path/to/oauth-client-secret.json
# YT_ANALYTICS_TOKEN_DIR=/path/outside/repository/to/private/tokens
# YT_ANALYTICS_NO_BROWSER=1
# Local-time hour values used for queue planning; the OS scheduler triggers run-daily.sh.
# PUBLISH_SLOTS=10,19
# Optional UI/channel labels. Internal channel keys remain en and te.
# EN_CHANNEL_NAME=My English Channel
# TE_CHANNEL_NAME=My Telugu Channel
# Optional, private Zapier publishing routes. Set these only on your own machine.
# YOUTUBE_CONNECTION_EN=your-english-zapier-connection-id
# YOUTUBE_CONNECTION_TE=your-telugu-zapier-connection-id
# Uploading transfers video and cover to a public file host for Zapier to fetch.
# Enable only after reviewing the public-hosting privacy implications.
# ALLOW_PUBLIC_FILE_HOSTING=1
